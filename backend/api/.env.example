# API Configuration
PORT=3000
NODE_ENV=development

# n8n Webhooks
N8N_WEBHOOK_BASE_URL=https://your-n8n.app.n8n.cloud/webhook
N8N_DECISION_WEBHOOK=/decision
N8N_REPLY_WEBHOOK=/reply

# Supabase Database
# SUPABASE_URL: Your project URL (e.g. https://abc123.supabase.co)
# SUPABASE_KEY: Your "Publishable key" (anon/public key) from Settings → API
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-publishable-key-here
# DATABASE_URL: Only needed for n8n Postgres nodes (direct connection)
# Get from: Supabase → Settings → Database → Connection string → URI
# DATABASE_URL=postgresql://postgres:[password]@db.your-project.supabase.co:5432/postgres

# Optional: Demo mode (uses mocked data instead of live APIs)
DEMO_MODE=false
