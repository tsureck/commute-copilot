# Eleven Bridge Environment Configuration

# Required: ElevenLabs API key
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here

# Optional: ElevenLabs configuration
ELEVENLABS_BASE_URL=https://api.elevenlabs.io
ELEVENLABS_VOICE_NAME=Matilda
# Set voice ID directly to bypass voices_read permission requirement (Matilda = XrExE9yKIg1WjnnlVkGX)
ELEVENLABS_VOICE_ID=XrExE9yKIg1WjnnlVkGX
ELEVENLABS_TTS_MODEL=eleven_multilingual_v2

# Optional: Application configuration
APP_HOST=0.0.0.0
APP_PORT=8000

# Optional: CORS configuration (comma-separated origins or * for all)
CORS_ALLOW_ORIGINS=*

# Optional: HTTP timeout in seconds
HTTP_TIMEOUT_SECONDS=30
